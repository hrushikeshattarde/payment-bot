# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Testing / typing / linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Environment / secrets — NEVER commit real credentials
.env
.env.*
!.env.example

# Google service-account keys. A leaked key with domain-wide delegation can
# impersonate mailboxes across the domain — keep these out of the repo entirely.
*service-account*.json
*service_account*.json
*credentials*.json
*creds*.json
*-key.json
# The console downloads a key as `<project-id>-<12 hex chars>.json`, which none of the
# names above match. Ignore that shape too — the key belongs outside the repo anyway.
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
*.pem
*.p12
secrets/

# Deployment parameters. No credentials — those are in Secrets Manager — but they do carry
# the mailbox, the Transport Pro host and the CargoTel cookie location, and this repo is
# public. params.example.json is the committed template.
deploy/params.*.json
!deploy/params.example.json

# Local machine settings
.claude/settings.local.json

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
gsheets-*.json

# Internal business data — this repo is public; keep these local.
# Saved CargoTel pages: real carrier names, contact emails, VINs and payable amounts.
# Tests use the synthetic fixture in tests/cargotel_pages.py instead.
loads/
load_*.html
# Roster candidates awaiting review. Same class as the two roster files below — real company
# names mapped to domains — and it was sitting untracked but NOT ignored, one `git add -A`
# away from being published.
factoring_domains_CANDIDATES*.json
# Carrier contact candidates from the mail sweep. Real company names mapped to real
# addresses, many of them people's names — the same class as the roster files below.
carrier_contacts_CANDIDATES*.json
# The hand-maintained carrier contact list itself (PAYBOT_CARRIER_CONTACTS_FILE). Same class
# again, and more sensitive than the candidates: every address in it is one a human confirmed
# belongs to a carrier, and most are personal free-mail accounts. The CANDIDATES pattern above
# does NOT cover this name.
carrier_contacts.json
factoring_domains.json
# Hand-verified send-from domains merged into the roster by the generator. Same class of
# data as the file above: real company names mapped to the domains we will disclose to.
factoring_domains_manual.json
docs/ESCALATIONS.md
# Settlements exports (factor remit emails) — internal data, repo is public.
data-*.csv
logs/
# `aws lambda invoke ... response.json` output from the smoke-test step — run summaries
# carry outcome counts only, but they are debris, not source.
response.json
