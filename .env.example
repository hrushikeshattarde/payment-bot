# -----------------------------------------------------------------------------
# Payments Email Bot — example configuration
#
# Copy to `.env` and fill in real values for local runs. NEVER commit `.env`.
# In production these come from SSM Parameter Store / Secrets Manager (PRD §8.1.1),
# not a file on disk.
# -----------------------------------------------------------------------------

# Runtime environment: local | dev | prod
PAYBOT_ENV=local

# Rollout phase (PRD §8.5). Phase 1 = every draft requires human Slack approval.
PAYBOT_ROLLOUT_PHASE=1

# --- Mailbox -----------------------------------------------------------------
PAYBOT_MAILBOX=paystatus@circledelivers.com

# --- Bulk fallback (PRD §3.3 / §5) -------------------------------------------
# Above this many loads in one email, reply with the portal link instead.
PAYBOT_BULK_THRESHOLD=5
PAYBOT_PORTAL_URL=https://circledelivers.com/payment-status-lookup/

# --- Business logic (PRD §4.1.1) ---------------------------------------------
# Timezone the API's estimated/actual payment dates are expressed in.
PAYBOT_PAY_DATE_TZ=EDT

# --- Amazon Bedrock (agent orchestration, PRD §8.1) --------------------------
# Model IDs are Bedrock inference profile / model identifiers.
PAYBOT_AWS_REGION=us-east-1
# Cheap model for high-volume classify/extract steps (PRD §8.1.1).
PAYBOT_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Larger model reserved for final reply drafting only.
PAYBOT_MODEL_DRAFT=us.anthropic.claude-sonnet-5-v1:0
PAYBOT_AGENT_MAX_ITERATIONS=12

# --- Slack (PRD §4.6) --------------------------------------------------------
PAYBOT_SLACK_APPROVAL_CHANNEL=#payments-approvals
PAYBOT_SLACK_SECURITY_CHANNEL=#payments-security
# Provided at runtime via secrets manager, not committed:
# PAYBOT_SLACK_BOT_TOKEN=
# PAYBOT_SLACK_SIGNING_SECRET=

# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
PAYBOT_LOG_LEVEL=INFO
