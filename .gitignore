# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Testing / typing / linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Environment / secrets — NEVER commit real credentials
.env
.env.*
!.env.example

# Google service-account keys. A leaked key with domain-wide delegation can
# impersonate mailboxes across the domain — keep these out of the repo entirely.
*service-account*.json
*service_account*.json
*credentials*.json
*creds*.json
*-key.json
# The console downloads a key as `<project-id>-<12 hex chars>.json`, which none of the
# names above match. Ignore that shape too — the key belongs outside the repo anyway.
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
*.pem
*.p12
secrets/

# Local machine settings
.claude/settings.local.json

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
gsheets-*.json

# Internal business data — this repo is public; keep these local.
factoring_domains.json
docs/ESCALATIONS.md
# Settlements exports (factor remit emails) — internal data, repo is public.
data-*.csv
logs/
