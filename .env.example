# -----------------------------------------------------------------------------
# Payments Email Bot — example configuration
#
# Copy to `.env` and fill in real values for local runs. NEVER commit `.env`.
# In production these come from SSM Parameter Store / Secrets Manager (PRD §8.1.1),
# not a file on disk.
#
# Providers, one per concern:
#   Transport Pro  — load data (both local and deployed)
#   Gmail          — a dedicated service account, impersonating the paystatus mailbox
#   Groq           — the LLM for LOCAL runs
#   Bedrock        — the LLM for the AWS DEPLOYMENT
# -----------------------------------------------------------------------------

# Runtime environment: local | dev | prod
PAYBOT_ENV=local

# Rollout phase (PRD §8.5). Phase 1 = every draft requires human approval.
PAYBOT_ROLLOUT_PHASE=1

# --- Mailbox -----------------------------------------------------------------
PAYBOT_MAILBOX=paystatus@circledelivers.com

# --- Bulk fallback (PRD §3.3 / §5) -------------------------------------------
# Above this many loads in one email, reply with the portal link instead.
PAYBOT_BULK_THRESHOLD=5
PAYBOT_PORTAL_URL=https://circledelivers.com/payment-status-lookup/

# --- Transport Pro API (PRD §4.3 / §9) ---------------------------------------
# Root of the Transport Pro Public API (the Postman collection's {{URL}}).
# Leave PAYBOT_TP_BASE_URL blank to keep using the mock client.
PAYBOT_TP_BASE_URL=
# All three are REQUIRED for a live run: the client authenticates with
# `POST /auth` using HTTP Basic, so it needs the real username and password.
# (Only in AWS do these come from SSM / Secrets Manager instead of this file.)
PAYBOT_TP_USERNAME=
PAYBOT_TP_PASSWORD=
PAYBOT_TP_TIMEOUT_SECONDS=30

# --- Gmail: dedicated service account (PRD §8.1.2) ---------------------------
# Requires `pip install -e ".[dev,google]"`.
#
# Use a service account created SPECIFICALLY for this bot, and a Workspace
# super-admin must authorise domain-wide delegation for its client_id with:
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.compose
# Run `payment-bot-local --check` to print the client_id and scopes to hand over.
PAYBOT_GOOGLE_SA_FILE=
# ...or paste the key's JSON contents instead of a path (for secret stores):
# PAYBOT_GOOGLE_SA_JSON=
PAYBOT_GOOGLE_TIMEOUT_SECONDS=30

# The mailbox to read and draft in — the user the service account impersonates.
# Blank falls back to PAYBOT_MAILBOX.
PAYBOT_GMAIL_USER=paystatus@circledelivers.com
# Gmail search syntax (not IMAP): is:unread | newer_than:2d | from:carrier.com
PAYBOT_GMAIL_QUERY=is:unread
PAYBOT_GMAIL_FETCH_LIMIT=10
# false leaves mail unread so you can reprocess it while iterating.
PAYBOT_GMAIL_MARK_SEEN=false
# Save each gate-passing reply to Drafts. Creating a draft never sends.
PAYBOT_GMAIL_CREATE_DRAFT=true

# --- Draft-only operation ----------------------------------------------------
# true = never take the auto-send path, whatever the rollout phase says.
# `payment-bot-local` forces this on regardless, so a local run cannot send email;
# this setting matters only if you wire the pipeline up yourself.
PAYBOT_DRAFT_ONLY=true
# Who to copy on the eventual reply. JSON list, because it is a tuple setting.
PAYBOT_REPLY_CC=["hrushikesh.attarde@circledelivers.com"]

# --- Agent loop --------------------------------------------------------------
PAYBOT_AGENT_MAX_ITERATIONS=12
# Cap per model turn. Too low truncates a draft mid-sentence.
PAYBOT_AGENT_MAX_TOKENS=4096

# --- Factoring senders -------------------------------------------------------
# Factoring companies you are willing to recognise, mapped to the domains they mail from.
# JSON, because it is a mapping setting.
#
# Needed because Transport Pro's API returns the factoring company's NAME and no contact
# address — verified on live data against both /voiceai/load/{n}/payment_information and
# GET /carrier/{id}. The remit email the Transport Pro UI shows is not in either response, so
# `factoring_emails` is always empty and there is nothing to match a sender against.
#
# Without this the only option is guessing from the company name, which is a substring test
# against the sender's flattened domain — a factor called "RTS" would be satisfied by
# `imports-llc.com`. Not good enough to authorise a disclosure. Entries here are matched on
# the WHOLE domain, and the key must appear in the name recorded on the load, so one factor
# cannot be answered about another factor's load.
#
# Recognising a factor is separate from choosing to answer them: a load whose sender matches
# here resolves to FACTORING, which the pre-send gate still blocks unless the factoring policy
# is enabled (PreSendGate(allow_factoring=...), currently off and not exposed as a setting).
# PAYBOT_FACTORING_DOMAINS={"rts financial": ["rtsfinancial.com", "ryanrts.com"], "otr solutions": ["otrsolutions.com"]}

# --- Groq: the LLM for LOCAL runs --------------------------------------------
# Get a key at https://console.groq.com/keys
PAYBOT_GROQ_API_KEY=
# Must support tool calling — the agent is a tool-use loop and depends on it entirely.
# Check available ids with:
#   curl -H "Authorization: Bearer $PAYBOT_GROQ_API_KEY" https://api.groq.com/openai/v1/models
PAYBOT_GROQ_MODEL=llama-3.3-70b-versatile
PAYBOT_GROQ_TIMEOUT_SECONDS=60

# Any OpenAI-compatible /chat/completions provider works — override the base URL and these
# names keep meaning "the local LLM". Groq's free tier is 100,000 tokens/day per
# ORGANISATION (not per key), which is roughly two emails, so a second provider is often
# needed just to test. Example, OpenRouter:
#   PAYBOT_GROQ_BASE_URL=https://openrouter.ai/api/v1
#   PAYBOT_GROQ_API_KEY=sk-or-v1-...
#   PAYBOT_GROQ_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Confirm tool support first — "tools" must appear in the model's supported_parameters at
# https://openrouter.ai/api/v1/models (a public endpoint, no key needed).
# PAYBOT_GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Amazon Bedrock: the LLM for the AWS DEPLOYMENT (PRD §8.1) ---------------
# Not used by local runs. Requires `pip install -e ".[aws]"`.
# Verify the id exists in your region: aws bedrock list-inference-profiles
PAYBOT_AWS_REGION=us-east-1
PAYBOT_MODEL_DRAFT=us.anthropic.claude-sonnet-5-v1:0

# --- Slack (PRD §4.6) — deployment only --------------------------------------
# Local runs post nothing to Slack; drafts go to Gmail Drafts and escalations to
# the console report and the JSON log. These channels are for the deployed
# Phase 1 approval flow, which needs a callback endpoint (see AWS_DEPLOYMENT.md).
PAYBOT_SLACK_APPROVAL_CHANNEL=#payments-approvals
PAYBOT_SLACK_SECURITY_CHANNEL=#payments-security
# PAYBOT_SLACK_BOT_TOKEN=
# PAYBOT_SLACK_SIGNING_SECRET=

# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
PAYBOT_LOG_LEVEL=INFO
