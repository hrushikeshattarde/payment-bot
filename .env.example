# -----------------------------------------------------------------------------
# Payments Email Bot — example configuration
#
# Copy to `.env` and fill in real values for local runs. NEVER commit `.env`.
# In production these come from SSM Parameter Store / Secrets Manager (PRD §8.1.1),
# not a file on disk.
#
# Providers, one per concern:
#   Transport Pro  — load data (both local and deployed)
#   Gmail          — a dedicated service account, impersonating the paystatus mailbox
#   OpenRouter     — the LLM for LOCAL runs, via the PAYBOT_GROQ_* settings (any
#                    OpenAI-compatible /chat/completions endpoint works; see below)
#   Bedrock        — the LLM for the AWS DEPLOYMENT
# -----------------------------------------------------------------------------

# Runtime environment: local | dev | prod
PAYBOT_ENV=local

# Rollout phase (PRD §8.5). Phase 1 = every draft requires human approval.
PAYBOT_ROLLOUT_PHASE=1

# --- Mailbox -----------------------------------------------------------------
PAYBOT_MAILBOX=paystatus@circledelivers.com

# --- Bulk fallback (PRD §3.3 / §5) -------------------------------------------
# Above this many loads in one email, reply with the portal link instead.
PAYBOT_BULK_THRESHOLD=5
PAYBOT_PORTAL_URL=https://circledelivers.com/payment-status-lookup/

# --- Transport Pro API (PRD §4.3 / §9) ---------------------------------------
# Root of the Transport Pro Public API (the Postman collection's {{URL}}).
# Leave PAYBOT_TP_BASE_URL blank to keep using the mock client.
PAYBOT_TP_BASE_URL=
# All three are REQUIRED for a live run: the client authenticates with
# `POST /auth` using HTTP Basic, so it needs the real username and password.
# (Only in AWS do these come from SSM / Secrets Manager instead of this file.)
PAYBOT_TP_USERNAME=
PAYBOT_TP_PASSWORD=
PAYBOT_TP_TIMEOUT_SECONDS=30

# --- Gmail: dedicated service account (PRD §8.1.2) ---------------------------
# Requires `pip install -e ".[dev,google]"`.
#
# Use a service account created SPECIFICALLY for this bot, and a Workspace
# super-admin must authorise domain-wide delegation for its client_id with:
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.compose
# Run `payment-bot-local --check` to print the client_id and scopes to hand over.
#
# `payment-bot-local --check` prints this key's client_email, client_id and project_id —
# the three values an admin needs — so they are not duplicated here. Key files are
# gitignored (`*-key.json`, `gsheets-*.json`, and the console's `<project>-<12 hex>.json`
# shape); a relative path resolves from the repo root, so keep the key beside `.env` or
# give an absolute path.
#
# Note if you reuse a service account created for another API (Sheets, Drive): the Gmail
# API must be enabled in THAT key's project, not just somewhere in the org. `--check`
# names the project and links the enable page.
PAYBOT_GOOGLE_SA_FILE=
# ...or paste the key's JSON contents instead of a path (for secret stores):
# PAYBOT_GOOGLE_SA_JSON=
PAYBOT_GOOGLE_TIMEOUT_SECONDS=30

# The mailbox to read and draft in — the user the service account impersonates.
# Blank falls back to PAYBOT_MAILBOX.
#
# ⚠ This must be a real licensed Gmail USER, not a group or an alias. At Circle Delivers
# paystatus@ is a Google Group, and a group has no mailbox to impersonate: requesting a
# delegated token for it fails with `unauthorized_client` however the delegation entry is
# configured — the same error you get when delegation is genuinely missing, which makes it
# easy to misdiagnose. Confirm by requesting a token for a known-good user: if that
# succeeds with the same client id and scopes, delegation is fine and the subject is the
# problem. (A subject that does not exist at all returns `invalid_grant` instead.)
#
# So impersonate a user who RECEIVES the group's mail, and narrow intake to the group with
# PAYBOT_GMAIL_QUERY below. Leave PAYBOT_MAILBOX as the group address: the client passes it
# as the group address, which is what stops mail whose From was DMARC-rewritten to the
# group ("carrier via Payment Status <paystatus@…>") being mistaken for our own outbound.
PAYBOT_GMAIL_USER=you@yourdomain.com
# Gmail search syntax (not IMAP): is:unread | newer_than:2d | from:carrier.com
#
# When impersonating a personal mailbox, a `to:` term is what confines intake to the
# group's mail instead of the whole inbox. Measured on a live mailbox: `to:<group>` is a
# SUPERSET of `cc:<group>`, `list:<group-list-id>` and `from:<group>` — Gmail's `to:`
# already spans the Cc and the group-rewritten From — so one term covers all of it.
# Colleagues' replies with the group Cc'd match too; the thread check drops them as
# already-answered, so the query does not need to exclude them.
PAYBOT_GMAIL_QUERY=is:unread to:paystatus@circledelivers.com
PAYBOT_GMAIL_FETCH_LIMIT=10
# false leaves mail unread so you can reprocess it while iterating.
PAYBOT_GMAIL_MARK_SEEN=false
# Save each gate-passing reply to Drafts. Creating a draft never sends.
PAYBOT_GMAIL_CREATE_DRAFT=true

# --- Draft-only operation ----------------------------------------------------
# true = never take the auto-send path, whatever the rollout phase says.
# `payment-bot-local` forces this on regardless, so a local run cannot send email;
# this setting matters only if you wire the pipeline up yourself.
PAYBOT_DRAFT_ONLY=true
# Who to copy on the eventual reply. JSON list, because it is a tuple setting.
PAYBOT_REPLY_CC=["hrushikesh.attarde@circledelivers.com"]

# --- Agent loop --------------------------------------------------------------
PAYBOT_AGENT_MAX_ITERATIONS=12
# Cap per model turn. Too low truncates a draft mid-sentence.
PAYBOT_AGENT_MAX_TOKENS=4096

# --- Factoring senders -------------------------------------------------------
# Factoring companies you are willing to recognise, mapped to the domains they mail from.
# JSON, because it is a mapping setting.
#
# Needed because Transport Pro's API returns the factoring company's NAME and no contact
# address — verified on live data against both /voiceai/load/{n}/payment_information and
# GET /carrier/{id}. The remit email the Transport Pro UI shows is not in either response, so
# `factoring_emails` is always empty and there is nothing to match a sender against.
#
# Without this the only option is guessing from the company name, which is a substring test
# against the sender's flattened domain — a factor called "RTS" would be satisfied by
# `imports-llc.com`. Not good enough to authorise a disclosure. Entries here are matched on
# the WHOLE domain, and the key must appear in the name recorded on the load, so one factor
# cannot be answered about another factor's load.
#
# Recognising a factor is separate from choosing to answer them: a load whose sender matches
# here resolves to FACTORING, which the pre-send gate still blocks unless PAYBOT_ALLOW_FACTORING
# is on (below). Either way the draft goes to a human.
# PAYBOT_FACTORING_DOMAINS={"rts financial": ["rtsfinancial.com", "ryanrts.com"], "otr solutions": ["otrsolutions.com"]}

# The full roster is too long for one .env line — 266 companies / 270 domains — so it lives in
# a JSON file with the same shape. Generated from the settlement system's factoring-company
# export (payName + remit email), which is the same table payments are remitted against:
#
#   python scripts/generate_factoring_domains.py data-1785515362757.csv factoring_domains.json
#
# The email IDs on that export are the source of these entries: only the DOMAIN of each remit
# address is kept, because the sender check matches on the whole domain (an entry cannot be
# per-address — a factor writes from ar@, billing@, noa@ at the same domain). Free-mail
# domains are dropped by the generator: a factor that remits to a Gmail address must not make
# every Gmail sender that factor. Rows with no email, or marked DNU/duplicate, are skipped.
#
# Inline PAYBOT_FACTORING_DOMAINS entries win on a key collision, so a hand-verified
# correction always beats the generated file. Both the file and the CSV are gitignored —
# internal business data, this repo is public. A configured-but-unreadable file raises at
# startup rather than silently authorising nobody.
PAYBOT_FACTORING_DOMAINS_FILE=factoring_domains.json

# --- Factoring reply policy --------------------------------------------------
# Whether a recognised factor may actually be ANSWERED. Off = every factoring email
# escalates, even when the roster identifies the sender. Factors (RTS, OTR, Love's,
# England, HaulPay…) are a large share of real inbound, and a rate question from the factor
# named on the load's NOA is legitimate — but turning this on is a deliberate policy
# decision, so it defaults to false.
PAYBOT_ALLOW_FACTORING=false
# Pre-funding flow: a roster-verified factor asks about a load that shows NO factor on file
# yet (their NOA hasn't reached us). Needs PAYBOT_ALLOW_FACTORING=true to have any effect.
# A load factored to a DIFFERENT company is never affected — that stays per-load bound.
PAYBOT_FACTORING_PRENOA_REPLIES=false

# --- The LLM for LOCAL runs: OpenRouter --------------------------------------
# The PAYBOT_GROQ_* names are historical — they mean "the local LLM", and any
# OpenAI-compatible /chat/completions provider works by overriding the base URL. We use
# OpenRouter rather than Groq directly because Groq's free tier is 100,000 tokens/day per
# ORGANISATION (not per key) — roughly two emails, which is not enough to test with.
#
# Get a key at https://openrouter.ai/keys. Put the real value in `.env`, never here —
# this file is the one thing .gitignore un-ignores (`!.env.example`), so anything written
# below is published with the repo.
PAYBOT_GROQ_BASE_URL=https://openrouter.ai/api/v1
PAYBOT_GROQ_API_KEY=sk-or-v1-...
# The model MUST support tool calling — the agent is a tool-use loop and depends on it
# entirely. Confirm before switching: "tools" must appear in the model's
# supported_parameters at https://openrouter.ai/api/v1/models (public, no key needed).
PAYBOT_GROQ_MODEL=deepseek/deepseek-v3.2
PAYBOT_GROQ_TIMEOUT_SECONDS=60

# To go back to Groq directly instead:
#   PAYBOT_GROQ_BASE_URL=https://api.groq.com/openai/v1
#   PAYBOT_GROQ_API_KEY=gsk_...           # https://console.groq.com/keys
#   PAYBOT_GROQ_MODEL=llama-3.3-70b-versatile
# List what a Groq key can reach with:
#   curl -H "Authorization: Bearer $PAYBOT_GROQ_API_KEY" https://api.groq.com/openai/v1/models

# --- Amazon Bedrock: the LLM for the AWS DEPLOYMENT (PRD §8.1) ---------------
# Not used by local runs. Requires `pip install -e ".[aws]"`.
# Verify the id exists in your region: aws bedrock list-inference-profiles
PAYBOT_AWS_REGION=us-east-1
PAYBOT_MODEL_DRAFT=us.anthropic.claude-sonnet-5-v1:0

# --- Slack (PRD §4.6) — deployment only --------------------------------------
# Local runs post nothing to Slack; drafts go to Gmail Drafts and escalations to
# the console report and the JSON log. These channels are for the deployed
# Phase 1 approval flow, which needs a callback endpoint (see AWS_DEPLOYMENT.md).
PAYBOT_SLACK_APPROVAL_CHANNEL=#payments-approvals
PAYBOT_SLACK_SECURITY_CHANNEL=#payments-security
# PAYBOT_SLACK_BOT_TOKEN=
# PAYBOT_SLACK_SIGNING_SECRET=

# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
PAYBOT_LOG_LEVEL=INFO
